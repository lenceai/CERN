# Required for embedding, chat, and fine-tuning operations
OPENAI_API_KEY=your_openai_api_key

# Optional model overrides
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
FINE_TUNED_MODEL=

# API settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# API security (recommended for non-local use)
API_AUTH_ENABLED=false
API_AUTH_KEY=change-me

# CORS settings (comma-separated lists)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-API-Key
CORS_ALLOW_CREDENTIALS=false

# Crawler behavior
CRAWL_START_PAGE=0
CRAWL_END_PAGE=7
CRAWL_DELAY=1.0
CRAWL_MAX_RETRIES=3
CRAWL_REQUEST_TIMEOUT_SECONDS=20

# OpenAI client behavior
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=3

# Fine-tuning monitor behavior
FINE_TUNING_POLL_INTERVAL_SECONDS=60
FINE_TUNING_POLL_TIMEOUT_SECONDS=7200
